# ===== Which LLM runs the brain: anthropic | gemini | groq =====
LLM_PROVIDER=groq

# ===== Model per provider (examples only, I will change these; NEVER hardcode model names in code) =====
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant

# ===== Optional: separate model for reading the screen (vision) =====
# Leave blank to use the main provider/model if it supports images.
VISION_PROVIDER=
VISION_MODEL=

# ===== Optional: automatic fallback if the main provider fails =====
FALLBACK_PROVIDER=

# ===== API keys =====
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# ===== Speech (Local by Default) =====
STT_PROVIDER=local            # local | groq
STT_MODEL=medium.en           # medium.en | small.en | base.en
STT_DEVICE=auto               # auto (detects cuda) | cuda | cpu
GROQ_STT_MODEL=whisper-large-v3-turbo

TTS_PROVIDER=piper            # piper (local offline neural) | edge (online neural) | pyttsx3 (SAPI5)
PIPER_VOICE=en_GB-alan-medium
TTS_SPEED=1.0                 # speech rate multiplier (1.0 = normal)
TTS_EDGE_VOICE=en-GB-RyanNeural
TTS_EDGE_RATE=-4%
TTS_EDGE_PITCH=-6Hz

# ===== Wake Word & Search =====
WAKEWORD_PHRASE=hey_jarvis    # e.g. 'hey_jarvis', 'alexa', 'hey bro', 'hello assistant'
SEARCH_ENGINE=google          # google | duckduckgo | bing | brave

# ===== Persona =====
USER_NAME=
HONORIFIC=sir                 # what Jarvis calls me: sir, boss, or leave blank
