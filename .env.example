# ==============================================================================
# JARVIS CONFIGURATION TEMPLATE
# ==============================================================================

# ==============================================================================
# 1. GENERAL & PERSONA
# (General assistant and user preferences grouped together)
# ==============================================================================
USER_NAME=
HONORIFIC=sir                 # What Jarvis calls you: sir, boss, ma'am, or blank
WAKEWORD_PHRASE=hey_jarvis    # Wake phrase: 'hey_jarvis', 'alexa', 'hey bro', etc.
SEARCH_ENGINE=google          # Web search: google | duckduckgo | bing | brave

# ==============================================================================
# 2. SPEECH-TO-TEXT (STT)
# ==============================================================================
# Step 1: Select STT provider: groq (fast cloud Whisper) | local (offline faster-whisper)
STT_PROVIDER=local

# --- Local STT Settings (faster-whisper) ---
STT_LOCAL_MODEL=medium.en     # Model: medium.en (~1.5GB GPU) | small.en (~460MB) | base.en (~140MB)
STT_LOCAL_DEVICE=auto         # Hardware device: auto (detects cuda) | cuda | cpu
STT_COMPUTE_TYPE=auto         # Compute precision: auto | float16 | int8

# --- Groq Cloud STT Settings ---
STT_GROQ_MODEL=whisper-large-v3-turbo

# ==============================================================================
# 3. TEXT-TO-SPEECH (TTS)
# ==============================================================================
# Step 1: Select TTS provider: edge (online neural cloud) | piper (local neural) | pyttsx3 (SAPI5 fallback)
TTS_PROVIDER=edge
TTS_SPEED=1.0                 # Speech rate multiplier (1.0 = normal)

# --- Cloud TTS Settings (Microsoft Edge Neural) ---
TTS_EDGE_VOICE=en-GB-RyanNeural
TTS_EDGE_RATE=-4%
TTS_EDGE_PITCH=-6Hz

# --- Local TTS Settings (Piper Neural) ---
TTS_PIPER_VOICE=en_GB-alan-medium

# ==============================================================================
# 4. LLM / BRAIN ORCHESTRATION
# ==============================================================================
# Step 1: Select LLM provider: groq | anthropic | gemini
LLM_PROVIDER=groq
FALLBACK_PROVIDER=            # Optional backup provider if primary fails (e.g. anthropic)
VISION_PROVIDER=              # Optional separate provider for screen vision (blank = use primary)
VISION_MODEL=                 # Optional vision model (blank = use primary default)

# ==============================================================================
# 5. PROVIDERS (All keys, models, and credentials for 1 provider together)
# ==============================================================================

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- ElevenLabs (Optional Alternative TTS) ---
ELEVENLABS_API_KEY=
